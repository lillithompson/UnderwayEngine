#!/bin/sh
# The independent review gate (vendor/UnderwayEngine/tooling/gates.md): refuse
# an AGENT's push whose commits have no passing or owner-accepted review (the
# owner pushing by hand is never stopped: `agentPush` in review.js). It starts
# no review itself; the review pass (`/ship`, `npm run ship`) does. Turned on per
# clone by `npm install` (postinstall sets core.hooksPath=.githooks). This is
# the whole of a project's .githooks/pre-push; the gate lives in the engine.
gate="$(git rev-parse --show-toplevel)/vendor/UnderwayEngine/tooling/review.js"
if [ ! -f "$gate" ]; then
  echo "pre-push: the engine submodule is not checked out, so the review gate cannot run: git submodule update --init" >&2
  exit 1
fi
exec node "$gate" check --pre-push "$1"
